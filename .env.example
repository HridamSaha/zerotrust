# Application
APP_NAME=ZeroTrust Access Control
APP_ENV=development
DEBUG=true
API_PREFIX=/api

# Security — change these before any non-local use
SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:5173

# Database (matches docker-compose.yml defaults)
POSTGRES_USER=zerotrust
POSTGRES_PASSWORD=zerotrust_dev_password
POSTGRES_DB=zerotrust
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
DATABASE_URL=postgresql+psycopg://zerotrust:zerotrust_dev_password@localhost:5433/zerotrust

# Risk policy thresholds (0–100). Engineering defaults; tune on validation data.
RISK_LOW_MAX=24
RISK_MEDIUM_MAX=49
RISK_HIGH_MAX=74
# Critical is RISK_HIGH_MAX+1 through 100

# Auth rate limiting
AUTH_RATE_LIMIT_REQUESTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# Demo accounts (development only — never use in production)
DEMO_ADMIN_EMAIL=admin@zerotrust.demo
DEMO_ADMIN_PASSWORD=AdminDemo!234
DEMO_USER_EMAIL=user@zerotrust.demo
DEMO_USER_PASSWORD=UserDemo!234
